# ============================================================================
# AI BlackBox Flight Recorder — .gitignore (DRAFT for review)
# ============================================================================
#
# Designed for the mono-repo at /home/ai-black-box-fc/Desktop/blackbox_poc./blackbox_poc/
# Goal: drop the project from 23 GB to <500 MB by excluding generated artifacts,
# build caches, venvs, BlackBox storage, and binary assets — while preserving
# all source code, plans, docs (text), and configuration.
#
# CRITICAL: Secrets must never be committed. The `.env` patterns below are
# load-bearing — if you change them, double-check no real keys leak into git.

# ============================================================================
# SECRETS — never commit (load-bearing for security)
# ============================================================================

# Top-level and per-component .env files (real values)
.env
.env.local
**/Secrets/
**/secrets/
**/.env
**/.env.local
**/supervisor.env

# Credential files & directories
credentials/
**/credentials/
**/*credentials*.json
**/*token*.json
**/*service-account*.json
**/*.pem
**/*.key
**/*.p12

# Asterisk / FreeSWITCH config files (contain inline SIP/ARI passwords)
Orchestrator/asterisk/configs/*.conf
# The FreeSWITCH stack under Docker/ is gone, but a box that ran it may still
# hold these local files with their passwords: keep them ignored.
Docker/freeswitch/config/freeswitch.xml
Docker/freeswitch/config/directory/

# Telephony gateway configs hold per-device credentials (encrypted, but never commit)
Orchestrator/asterisk/gateways.json

# IVR prompts made per box at runtime: operator menus (from its operator names)
# and the optional prompts ensure_all_prompts makes when TTS works. Ignored so
# they are never committed and a pull can always replace them; to ship one,
# drop its line here and `git add` it. The prompts the IVR falls back to are
# tracked. ensure_all_prompts installs both kinds where Asterisk plays them.
Orchestrator/asterisk/ivr_cache/operator_menu_*.wav
Orchestrator/asterisk/ivr_cache/pin_prompt_*digit.wav
!Orchestrator/asterisk/ivr_cache/pin_prompt_4digit.wav
Orchestrator/asterisk/ivr_cache/pin_locked.wav
Orchestrator/asterisk/ivr_cache/pin_unavailable.wav

# Claude Code local config (per-machine permissions, not project source)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# SQLite databases (runtime data; not source)
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.db-wal
**/*.db-shm
**/*.sqlite-wal
**/*.sqlite-shm

# Allow templates / examples (these have placeholders, not real values)
!**/.env.template
!**/.env.example
!**/*.env.example

# Allow vendored tokenizer assets (WI-11): public model vocabularies fetched
# at build time by scripts/vendor_tokenizers.py — qwen3/tokenizer.json would
# otherwise be swallowed by the `**/*token*.json` credential pattern above.
# These files contain no secrets (BPE merges/vocab only).
!Orchestrator/tokenizers_vendored/**

# ============================================================================
# BlackBox immutable storage — not suitable for git
# ============================================================================

Volumes/
Manifest/
Fossils/
# Runtime databases (tasks.db + -wal/-shm), 0700 — moved out of the served
# Portal/ tree 2026-10 (Orchestrator/migrations/tasks_db_location.py). Anchored:
# the Android app has source packages named data/.
/data/

# ============================================================================
# Generated media — outputs of BlackBox tools, not source
# ============================================================================

Portal/uploads/
# Generated downloadable artifacts (config.ARTIFACTS_DIR, 4-day retention):
# operator output such as PDFs and worksheets — never source (audit W31).
Portal/artifacts/
# Local-only zellij iframe smoke page: never committed (see
# docs/plans/2026-06-07-tg200-production-pass.md). It is .html, so /ui serves it
# while it sits in Portal/ — move it to Portal/dev/ or delete it.
/Portal/**/zellij-iframe-smoke.html

# ============================================================================
# Apps/ — customer-created app territory (T1 / audit C1 + I2)
# ============================================================================
# Apps/ is the convention dir for customer-built sub-apps. The update flow
# does `git reset --hard origin/main` which would overwrite a customer-created
# Apps/<name>/ if a future commit added a tracked Apps/<name>/ of the same
# slug. Untracking everything under Apps/* prevents that collision class.
# Existing tracked content (PelvicVibeAndroid example app) is grandfathered
# via the allowlist exception below — its git history continues normally.
# New example apps should live in docs/examples/ instead.
Apps/*
!Apps/.gitkeep
!Apps/README.md
!Apps/PelvicVibeAndroid/
media_files/

# ============================================================================
# Python — venvs, bytecode, caches
# ============================================================================

**/venv/
**/.venv/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/htmlcov/
**/.coverage
**/.coverage.*
**/coverage.xml
**/*.egg-info/

# ============================================================================
# Android / Gradle / IntelliJ — build outputs and IDE state
# ============================================================================

**/build/
**/.gradle/
**/.idea/
**/captures/
**/local.properties
**/*.apk
**/*.aab
**/*.aar
**/*.dex
**/*.iml
**/.cxx/
**/proguard/

# ============================================================================
# Node / NPM
# ============================================================================

**/node_modules/
**/.npm/
**/yarn.lock
# Portal jsdom test harness (tests/web/package-lock.json IS committed; its
# node_modules is installed with `npm ci` and never lives under Portal/, which
# is served to browsers at /ui)
tests/web/node_modules/

# ============================================================================
# Browser profiles + binaries (Sovereign Browser feature)
# ============================================================================

Orchestrator/browser/profiles/
Orchestrator/browser/chromedriver*

# ============================================================================
# Large model files / firmware images / binary assets
# ============================================================================

docs/ugv-beast/images/
**/*.onnx
**/*.tflite
**/*.pt
**/*.pth
**/*.safetensors
**/*.gguf
**/*.bin
**/jetson-image.zip
**/*-firmware.zip

# ============================================================================
# Archive — explicitly archived, doesn't ship
# ============================================================================

Archive/

# ============================================================================
# Operating-system + editor cruft
# ============================================================================

**/.DS_Store
**/Thumbs.db
**/*.swp
**/*.swo
**/*~
**/.vscode/
**/*.bak
**/*.backup

# ============================================================================
# Project-specific transient state
# ============================================================================

dev_snapshot.json
AI_BlackBox_Portal_Android_MVP*.zip
**/state.json.tmp
**/*.lock.tmp

# ============================================================================
# Logs (don't ship runtime logs)
# ============================================================================

**/*.log
**/logs/
!docs/**/*.log    # exception: docs that include log examples

# ============================================================================
# Per-component gradle/build leftovers we might miss above
# ============================================================================

AI_BlackBox_Portal_Android_MVP*/AI_BlackBox_Portal_Android_MVP/AI_BlackBox_Portal/app/build/
AI_BlackBox_Portal_Android_MVP*/AI_BlackBox_Portal_Android_MVP/AI_BlackBox_Portal/build/
AI_BlackBox_Portal_Android_MVP*/AI_BlackBox_Portal_Android_MVP/AI_BlackBox_Portal/.gradle/
AI_BlackBox_Portal_Android_MVP*/AI_BlackBox_Portal_Android_MVP/AI_BlackBox_Portal/.idea/

# ============================================================================
# Notes for future maintainers
# ============================================================================
# 1. The `Apps/` directory now ignores everything by default (audit C1) —
#    customer-created apps live here at runtime and the update flow does
#    `git reset --hard` which would stomp collisions. Only `Apps/.gitkeep`,
#    `Apps/README.md`, and the grandfathered `Apps/PelvicVibeAndroid/`
#    example are tracked. Add new examples to `docs/examples/` instead.
# 2. The `Apps/PelvicVibeAndroid/` sub-project may have its own gradle/build/
#    dirs — those are caught by the `**/build/` and `**/.gradle/` patterns.
# 3. Templates (.env.template, .env.example) are explicitly ALLOWED via the
#    `!**/.env.template` etc. negations — they document expected env shape.
# 4. If you add new generated-output directories (e.g. a new feature that
#    writes media to /Outputs/), add them to the "Generated media" section
#    above before doing the next commit.

# ============================================================================
# Tauri build artifacts (installer/ — Track 3 setup wrapper)
# ============================================================================

installer/src-tauri/target/
installer/node_modules/
installer/dist/.cache/

# Onboarding state (per-install, never commit)
.onboarding_state.json
.onboarding_complete
.env.backup.*

# ============================================================================
# Per-customer state files (bootstrapped from .template at install time)
# ============================================================================
# config.ini holds operator roster + tailnet pairing — populated by wizard.
# Customer install bootstraps from config.ini.template via Scripts/install.sh.
config.ini
# Contacts directory holds personal contact data — never ship in customer ZIPs.
Contacts/contacts.json
# ...nor its migration backups and atomic-write temp files (contacts.py).
Contacts/contacts.json.bak-*
Contacts/.contacts.json.*.tmp
# Per-install device registry state (template at devices.json.template) —
# customer's tailnet devices populate via /devices/sync-tailscale on first use.
Orchestrator/device_registry/devices.json
# On-device (local Gemma) provider attestation registry — written at runtime
# as phones attest; per-install device-trust state, never commit.
Orchestrator/local_provider/local_devices.json
# Runtime-store sidecars outside Manifest/ (Orchestrator/utils/atomic_json.py):
# a store that did not parse is kept as <name>.corrupt-<UTC> instead of being
# overwritten, and writes go through a private temp sibling. None may make the
# serving tree look dirty to the updater.
Contacts/contacts.json.corrupt-*
Orchestrator/local_provider/local_devices.json.corrupt-*
Orchestrator/local_provider/.local_devices.json.*.tmp
# The temp sibling is '.' + the file's name, so the root .env's (and its
# backups') are '..env.<rand>.tmp' / '..env.backup.<ts>.<rand>.tmp'.
/..env.*.tmp
/.config.ini.*.tmp

# Zellij CLI Agent state: (operator, provider, app) -> session_name +
# token_name mapping. Per-install runtime data; NEVER stores raw token
# UUIDs (audit I7). Reconciled at orchestrator startup against Zellij's
# tokens.db via zellij_state.reconcile_or_wipe().
Orchestrator/cli_agent/state/zellij_sessions.json

# Antigravity CLI (agy) runtime config — created by ~/.local/bin/agy install
.antigravitycli/

# Project-scope MCP configs: these get auto-loaded by claude/gemini when run
# from this directory, but they hold ABSOLUTE PATHS to MCP/venv/bin/python +
# blackbox_mcp_server.py. Committing them means every customer install
# inherits the dev box's paths, which don't exist on their machine — and
# Claude HANGS silently trying to launch the broken project-scope MCP, never
# rendering its UI (Brandon hit this on MSO2 2026-05-23). install.sh Step 2b
# already writes USER-scope MCP registrations with correct per-machine paths
# via `claude mcp add -s user`, which is the right layer for this — project
# scope shouldn't ship at all.
.mcp.json
.gemini/settings.json
# Same class for Codex: .codex/config.toml holds the dev box's absolute MCP
# paths (audit W34).
/.codex/

# Convenience symlink install.sh recreates on every box -> Scripts/blackbox-status.sh
# (the tracked script). Anchored so the real script stays tracked (audit W34).
/blackbox-status.sh

# stray 'script' command capture artifact
typescript

# git worktrees (superpowers isolated workspaces)
.worktrees/

# secrets dir / worktree convenience symlink — must never be committed
credentials

# retrieval eval: DERIVED ground-truth artifacts (rebuildable via
# eval/build_ground_truth.py); corpus.jsonl + queries.jsonl ARE tracked.
eval/ground_truth/_store/
eval/ground_truth/_body_cache.json

# ToolVault tool-embedding cache — PER-BOX derived, never committed. Each box
# (re)embeds its own tool vectors under ITS chosen embedding model: boot-sync
# (startup_toolvault_embedding_sync) + the onboarding /save heal-trigger +
# /toolvault/reload + the model-switch cutover. A committed copy would ship one
# box's model/dims to every clone and go stale on every description edit.
ToolVault/embeddings.json
diagnostics/voice_probes/assets/
