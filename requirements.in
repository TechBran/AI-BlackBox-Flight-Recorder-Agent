aiohttp>=3.14.3,<4              # client path of the provider calls; CVE-2026-34518, -47265 (credentials kept across redirects), -54275 (SNI bypass), decompression bombs
urllib3>=2.8.0,<3               # imported by utils/safe_fetch.py; CVE-2025-66418, -66471, CVE-2026-21441, -97689
certifi>=2026.7.22              # safe_fetch.py's CA bundle; calendar-versioned CA data, so no cap

